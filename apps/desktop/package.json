{
  "name": "desktop",
  "version": "0.2.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:dir": "tsc && vite build && electron-builder --dir",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@sue/board-core": "workspace:*",
    "@sue/board-react": "workspace:*",
    "@sue/board-react-text": "workspace:*",
    "@sue/board-react-workflow": "workspace:*",
    "@sue/board-workflow": "workspace:*",
    "@sue/verd-board-agent": "workspace:*",
    "@sue/verd-board-app": "workspace:*",
    "@sue/verd-board-ui": "workspace:*",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "@sue/board-markdown-to-text": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "^4.2.0",
    "electron": "44.11.3",
    "electron-builder": "^24.9.1",
    "eslint": "^9.22.0",
    "typescript": "^6.0.3",
    "vite": "^6.2.2",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vitest": "^3.0.8"
  },
  "build": {
    "appId": "com.verdboard.desktop",
    "productName": "VerdBoard",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist{,/**/*}",
      "dist-electron{,/{main,preload}.js}",
      "!node_modules{,/**/*}",
      "build/icon.png"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.icns",
      "extendInfo": {
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.verdboard.canvas",
            "UTTypeDescription": "VerdBoard Canvas",
            "UTTypeConformsTo": [
              "public.json"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "verd"
              ],
              "public.mime-type": "application/vnd.verdscrolls+json"
            }
          }
        ],
        "UTImportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "net.daringfireball.markdown",
            "UTTypeDescription": "Markdown",
            "UTTypeConformsTo": [
              "public.plain-text"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "md",
                "markdown"
              ],
              "public.mime-type": "text/markdown"
            }
          }
        ]
      },
      "extraResources": [
        {
          "from": "build/default-file-handler",
          "to": "default-file-handler"
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "desktop": {
        "Exec": "verdboard %F"
      },
      "executableName": "verdboard"
    },
    "extraResources": [
      {
        "from": "build/builtin-workspaces/workspace",
        "to": "workspace",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/builtin-workspaces/agent-patterns",
        "to": "agent-patterns",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/agent-resources/${os}-${arch}",
        "to": "agent-tools",
        "filter": [
          "**/*"
        ]
      }
    ],
    "dmg": {
      "icon": "build/icon.icns"
    },
    "beforePack": "./electron-builder-hooks.cjs",
    "fileAssociations": [
      {
        "ext": "md",
        "name": "VerdBoard.Markdown",
        "role": "Editor",
        "rank": "Default",
        "mimeType": "text/markdown"
      },
      {
        "ext": "markdown",
        "name": "VerdBoard.Markdown",
        "role": "Editor",
        "rank": "Default",
        "mimeType": "text/markdown"
      },
      {
        "ext": "verd",
        "name": "VerdBoard.Canvas",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/vnd.verdscrolls+json"
      }
    ],
    "nsis": {
      "include": "build/file-associations.nsh"
    }
  },
  "productName": "VerdBoard"
}
