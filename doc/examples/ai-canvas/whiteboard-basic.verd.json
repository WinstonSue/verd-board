{
  "format": "verd-frame",
  "version": 2,
  "frame": {
    "id": "canvas-basic",
    "kind": "frame",
    "cellType": "frame",
    "name": "基础白板",
    "geometry": { "x": 0, "y": 0, "width": 960, "height": 640 },
    "children": ["shape-request", "shape-process", "shape-decision", "text-note", "arrow-1", "arrow-2"],
    "groups": ["group-review"],
    "view": { "theme": { "themeColorMode": "default" } }
  },
  "cells": {
    "shape-request": {
      "id": "shape-request",
      "kind": "geometry",
      "cellType": "node",
      "geometry": {
        "x": 80,
        "y": 120,
        "width": 160,
        "height": 64,
        "outline": "roundRectangle"
      },
      "ports": [
        { "id": "top", "side": "top", "direction": "both" },
        { "id": "right", "side": "right", "direction": "both" },
        { "id": "bottom", "side": "bottom", "direction": "both" },
        { "id": "left", "side": "left", "direction": "both" }
      ],
      "appearance": {
        "fill": "#ffffff",
        "strokeColor": "#64748b",
        "strokeWidth": 2
      },
      "content": { "label": "提交请求" }
    },
    "shape-process": {
      "id": "shape-process",
      "kind": "geometry",
      "cellType": "node",
      "geometry": {
        "x": 360,
        "y": 120,
        "width": 160,
        "height": 64,
        "outline": "process"
      },
      "ports": [
        { "id": "top", "side": "top", "direction": "both" },
        { "id": "right", "side": "right", "direction": "both" },
        { "id": "bottom", "side": "bottom", "direction": "both" },
        { "id": "left", "side": "left", "direction": "both" }
      ],
      "appearance": {
        "fill": "#eff6ff",
        "strokeColor": "#2563eb",
        "strokeWidth": 2
      },
      "content": { "label": "系统处理" }
    },
    "shape-decision": {
      "id": "shape-decision",
      "kind": "geometry",
      "cellType": "node",
      "geometry": {
        "x": 640,
        "y": 104,
        "width": 140,
        "height": 96,
        "outline": "diamond"
      },
      "ports": [
        { "id": "top", "side": "top", "direction": "both" },
        { "id": "right", "side": "right", "direction": "both" },
        { "id": "bottom", "side": "bottom", "direction": "both" },
        { "id": "left", "side": "left", "direction": "both" }
      ],
      "appearance": {
        "fill": "#fefce8",
        "strokeColor": "#a16207",
        "strokeWidth": 2
      },
      "content": { "label": "需要复核?" }
    },
    "text-note": {
      "id": "text-note",
      "kind": "geometry",
      "cellType": "node",
      "geometry": {
        "x": 640,
        "y": 240,
        "width": 200,
        "height": 40,
        "outline": "text"
      },
      "appearance": {
        "fill": "none",
        "strokeColor": "none",
        "strokeWidth": 2
      },
      "content": { "label": "人工复核入口" }
    },
    "arrow-1": {
      "id": "arrow-1",
      "kind": "arrow",
      "cellType": "edge",
      "source": { "cellId": "shape-request", "portId": "right" },
      "target": { "cellId": "shape-process", "portId": "left" },
      "route": { "mode": "auto" },
      "labels": [{ "text": "创建工单" }],
      "data": { "sourceMarker": "none", "targetMarker": "arrow" }
    },
    "arrow-2": {
      "id": "arrow-2",
      "kind": "arrow",
      "cellType": "edge",
      "source": { "cellId": "shape-process", "portId": "right" },
      "target": { "cellId": "shape-decision", "portId": "left" },
      "route": { "mode": "orthogonal" },
      "labels": [{ "text": "校验" }],
      "appearance": { "strokeColor": "#334155", "strokeWidth": 2 },
      "data": { "sourceMarker": "none", "targetMarker": "arrow" }
    },
    "group-review": {
      "id": "group-review",
      "kind": "group",
      "cellType": "group",
      "members": ["shape-decision", "text-note"]
    }
  }
}
