{
  "name": "@sue/board-markdown-to-board",
  "version": "1.0.0",
  "description": "Markdown to VerdBoard mind map",
  "main": "./dist/index.cjs",
  "types": "./src/index.ts",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@sue/board-common": "workspace:*",
    "@sue/board-core": "workspace:*",
    "@sue/board-mind": "workspace:*",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.0",
    "eslint": "^9.22.0",
    "jsdom": "^24.0.0",
    "typescript": "^6.0.3",
    "vitest": "^3.0.8"
  },
  "module": "./dist/index.js",
  "source": "./src/index.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs",
        "default": "./dist/index.js"
      }
    }
  }
}
