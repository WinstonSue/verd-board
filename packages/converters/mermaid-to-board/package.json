{
  "name": "@sue/board-mermaid-to-board",
  "version": "1.0.0",
  "description": "Mermaid to VerdBoard diagrams",
  "main": "./dist/index.cjs",
  "types": "./src/index.ts",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@sue/board-architecture": "workspace:*",
    "@sue/board-common": "workspace:*",
    "@sue/board-core": "workspace:*",
    "@sue/board-draw": "workspace:*",
    "@sue/board-workflow": "workspace:*",
    "@types/d3": "^7.4.3",
    "@types/dompurify": "3.0.5",
    "mermaid": "10.9.3",
    "@sue/board-uml": "workspace:*"
  },
  "devDependencies": {
    "eslint": "^9.22.0",
    "jsdom": "^24.0.0",
    "typescript": "^6.0.3",
    "vitest": "^3.0.8"
  },
  "module": "./dist/index.js",
  "source": "./src/index.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs",
        "default": "./dist/index.js"
      }
    }
  }
}
