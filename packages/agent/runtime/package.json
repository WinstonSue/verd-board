{
  "name": "@sue/verd-board-agent",
  "version": "0.1.0",
  "type": "module",
  "private": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.preview.config.ts",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "development": "./src/node.ts",
      "types": "./src/node.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    },
    "./cli": {
      "development": "./src/cli.ts",
      "types": "./src/cli.ts",
      "import": "./dist/cli.js",
      "require": "./dist/cli.cjs"
    }
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./node": {
        "types": "./dist/node.d.ts",
        "import": "./dist/node.js",
        "require": "./dist/node.cjs"
      },
      "./cli": {
        "types": "./dist/cli.d.ts",
        "import": "./dist/cli.js",
        "require": "./dist/cli.cjs"
      }
    },
    "registry": "https://packages.aliyun.com/69f800449b7ce0afb00bda0e/npm/npm-registry/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WinstonSue/verd-board.git",
    "directory": "packages/agent/runtime"
  },
  "devDependencies": {
    "vite": "^6.2.2",
    "vitest": "^3.0.8",
    "eslint": "^9.22.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@sue/board-react": "workspace:*",
    "@sue/board-react-draw": "workspace:*",
    "@sue/board-react-mind": "workspace:*",
    "@sue/board-react-workflow": "workspace:*",
    "@sue/board-react-architecture": "workspace:*",
    "@sue/board-react-uml": "workspace:*"
  },
  "bin": {
    "verd": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@sue/verd-board-agent-patterns": "workspace:*",
    "@sue/board-common": "workspace:*",
    "@sue/board-core": "workspace:*",
    "@sue/board-draw": "workspace:*",
    "@sue/board-mind": "workspace:*",
    "@sue/board-workflow": "workspace:*",
    "@sue/board-architecture": "workspace:*",
    "@sue/board-uml": "workspace:*",
    "@sue/board-layouts": "workspace:*",
    "@sue/board-markdown-to-text": "workspace:*",
    "@sue/board-mermaid-to-board": "workspace:*",
    "@sue/board-react-text": "workspace:*",
    "playwright": "1.58.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "jsdom": "22.1.0",
    "@sue/verd-board-file-workspace": "workspace:*",
    "@sue/verd-board-workspace": "workspace:*"
  }
}
