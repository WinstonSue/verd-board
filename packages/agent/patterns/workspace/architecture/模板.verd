    "pattern:architecture/canvas-arch:relation-legend": {
      "id": "pattern:architecture/canvas-arch:relation-legend",
      "kind": "card",
      "cellType": "node",
      "geometry": {
        "x": 660,
        "y": 40,
        "width": 280,
        "height": 260,
        "outline": "roundRectangle"
      },
      "content": {
        "label": "关系图例\n虚线开放箭头：依赖，使用方指向提供方。\n实线实心箭头：数据流，发送方指向接收方。\n层间线较粗并沿外围，模块线连接具体组件。",
        "text": {
          "schemaVersion": 1,
          "id": "pattern:architecture/canvas-arch:relation-legend:text",
          "kind": "block",
          "content": {
            "type": "doc",
            "content": [
              {
                "type": "heading",
                "attrs": {
                  "level": 3
                },
                "content": [
                  {
                    "type": "text",
                    "text": "关系图例"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "虚线开放箭头：依赖，使用方指向提供方。"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "实线实心箭头：数据流，发送方指向接收方。"
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "层间线较粗并沿外围，模块线连接具体组件。"
                  }
                ]
              }
            ]
          },
          "plainText": "关系图例\n虚线开放箭头：依赖，使用方指向提供方。\n实线实心箭头：数据流，发送方指向接收方。\n层间线较粗并沿外围，模块线连接具体组件。"
        }
      },
      "appearance": {
        "strokeWidth": 1,
        "colorSources": {
          "fill": "theme",
          "strokeColor": "theme"
        }
      }
    },
