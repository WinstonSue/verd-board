{
  "name": "@sue/verd-board-agent-patterns",
  "version": "2.1.1",
  "type": "module",
  "private": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "workspace",
    "catalog.json",
    "rules.json",
    "agent",
    "recommendations.json"
  ],
  "scripts": {
    "build": "vite build",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./agent": {
      "development": "./src/agent.ts",
      "types": "./src/agent.ts",
      "import": "./dist/agent.js",
      "require": "./dist/agent.cjs"
    },
    "./recommendations": {
      "development": "./src/recommendations.ts",
      "types": "./src/recommendations.ts",
      "import": "./dist/recommendations.js",
      "require": "./dist/recommendations.cjs"
    }
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./agent": {
        "types": "./dist/agent.d.ts",
        "import": "./dist/agent.js",
        "require": "./dist/agent.cjs"
      },
      "./recommendations": {
        "types": "./dist/recommendations.d.ts",
        "import": "./dist/recommendations.js",
        "require": "./dist/recommendations.cjs"
      }
    },
    "registry": "https://packages.aliyun.com/69f800449b7ce0afb00bda0e/npm/npm-registry/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WinstonSue/verd-board.git",
    "directory": "packages/agent/patterns"
  },
  "devDependencies": {
    "vite": "^6.2.2",
    "vitest": "^3.0.8",
    "eslint": "^9.22.0"
  }
}
