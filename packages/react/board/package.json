{
  "name": "@sue/board-react",
  "version": "2.0.0",
  "main": "./dist/index.cjs",
  "types": "./src/index.ts",
  "private": false,
  "scripts": {
    "build": "vite build",
    "dev": "node -e \"process.exit(0)\"",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@sue/board-common": "workspace:*",
    "@sue/board-core": "workspace:*",
    "@sue/board-react-text": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "eslint": "^9.22.0",
    "vite": "^6.2.2",
    "vitest": "^3.0.8"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "type": "module",
  "module": "./dist/index.js",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs",
        "default": "./dist/index.js"
      }
    },
    "registry": "https://packages.aliyun.com/69f800449b7ce0afb00bda0e/npm/npm-registry/",
    "access": "public"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "./src/style.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WinstonSue/verd-board.git",
    "directory": "packages/react/board"
  }
}
