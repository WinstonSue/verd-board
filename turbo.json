{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local",
    "scripts/lib-vite.ts",
    "scripts/pdf-assets.ts"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-electron/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "VERDBOARD_USER_DATA_PATH",
        "VERDBOARD_WORKSPACE_PATH",
        "VERDBOARD_BUILTIN_WORKSPACE_PATH"
      ]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "@sue/verd-board-agent-patterns#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/packages/engine/**/src/**",
        "$TURBO_ROOT$/packages/react/**/src/**",
        "$TURBO_ROOT$/packages/agent/runtime/src/**",
        "workspace/.verdscrolls/config.json",
        "workspace/.verdscrolls/.gitignore",
        "$TURBO_ROOT$/packages/workspace/core/src/**"
      ],
      "outputs": ["dist/**"]
    },
    "service#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/workspace/**",
        "$TURBO_ROOT$/packages/agent/patterns/workspace/**",
        "$TURBO_ROOT$/scripts/**"
      ]
    }
  },
  "globalPassThroughEnv": [
    "VERD_AGENT_RESOURCES",
    "VERD_AGENT_RESOURCE_TEST_PATH"
  ]
}
