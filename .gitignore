# compiled output
dist
tmp
/out-tsc
packages/*/dist
apps/*/dist

# Playwright
test-results
playwright-report

# dependencies
node_modules
.pnpm-store/

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

# Turborepo
.turbo

# Project workspace content is versioned; device/session state is local.
/workspace/.verdboard/
/workspace/**/*.tmp

# ai-config-manager：正文在 .agents/skills，.cursor/skills 是软链
/.agents/*
!/.agents/skills/

.cursor/*
!.cursor/rules/
!.cursor/rules/*.mdc
