{
  "name": "@sue/verd-board-source",
  "version": "0.0.1",
  "author": "winston-sue",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.18.0"
  },
  "scripts": {
    "start": "pnpm dev:desktop",
    "dev": "pnpm dev:desktop",
    "dev:web": "node scripts/web.mjs dev",
    "build": "turbo run build --filter=!desktop",
    "lint": "eslint . && node scripts/check-ui-styles.mjs",
    "typecheck": "tsc --noEmit -p apps/desktop/tsconfig.typecheck.json && tsc --noEmit -p packages/product/app/tsconfig.json && tsc --noEmit -p tsconfig.cells.json && tsc --noEmit -p apps/service/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.app.json && tsc --noEmit -p packages/workspace/core/tsconfig.json",
    "build:web": "node scripts/web.mjs build",
    "build:web:e2e": "node scripts/web.mjs build-e2e",
    "build:desktop": "turbo run build --filter=desktop",
    "test": "turbo run test --concurrency=2 && node scripts/test-scripts.mjs",
    "workspace:check": "node scripts/workspace.mjs check && node --test scripts/workspace.test.mjs",
    "workspace:refresh": "node scripts/workspace.mjs refresh",
    "test:e2e": "pnpm --filter web-e2e test:e2e",
    "test:e2e:prod": "pnpm --filter web-e2e exec playwright test --config playwright.prod.config.ts",
    "test:e2e:desktop": "playwright test --config tests/desktop-e2e/playwright.config.ts",
    "test:consumer": "pnpm --filter consumer-vite build && node scripts/test-consumer.mjs",
    "pack:dry": "node scripts/pack-public.mjs --dry-run",
    "format": "prettier --write .",
    "release": "node scripts/release.mjs version",
    "pub": "node scripts/release.mjs publish",
    "postinstall": "node scripts/sync-skills.mjs",
    "skills:sync": "node scripts/sync-skills.mjs",
    "skills:status": "ai-config-manager status",
    "check:plugins": "node scripts/check-plugin-boundaries.mjs",
    "test:plugin-consumers": "node scripts/test-plugin-consumers.mjs",
    "prepare:schema-integration": "node scripts/prepare-schema-integration.mjs",
    "package:desktop": "node scripts/package-desktop.mjs",
    "icons:desktop": "node scripts/generate-desktop-icons.mjs",
    "dev:desktop": "turbo run dev --filter=desktop",
    "test:e2e:desktop:prod": "playwright test --config tests/desktop-e2e/playwright.prod.config.ts",
    "test:e2e:desktop:packaged": "playwright test --config tests/desktop-e2e/playwright.packaged.config.ts",
    "test:agent-consumer": "node scripts/test-agent-consumer.mjs",
    "agent": "node packages/agent/runtime/dist/cli.js",
    "prepare:agent-resources": "node scripts/prepare-agent-resources.mjs",
    "build:content": "node scripts/prepare-builtin-workspaces.mjs",
    "start:web": "node scripts/web.mjs start",
    "format:check": "prettier --check .",
    "test:scripts": "node scripts/test-scripts.mjs",
    "check:dev": "node scripts/quality-gate.mjs dev",
    "check:ci": "node scripts/quality-gate.mjs ci",
    "check:release": "node scripts/quality-gate.mjs release",
    "release:review": "node scripts/release-review.mjs draft",
    "test:remote": "node scripts/remote-test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.36.0",
    "@types/node": "^22.13.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/ui": "^3.0.8",
    "@ylib/ai-config-manager": "1.0.0-beta.0",
    "electron": "45.1.0",
    "electron-builder": "^24.9.1",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.2.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "jsdom": "~22.1.0",
    "prettier": "^3.1.0",
    "sass": "^1.55.0",
    "turbo": "^2.0.1",
    "@changesets/cli": "^2.27.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.26.0",
    "vite": "^6.2.2",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^3.0.8"
  },
  "private": true
}
