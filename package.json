{
  "name": "@sue/verd-board-source",
  "version": "0.0.1",
  "author": "winston-sue",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11.18.0"
  },
  "scripts": {
    "start": "turbo run dev --filter=desktop",
    "dev": "turbo run dev --filter=desktop",
    "dev:web": "turbo run dev --filter=web",
    "build": "turbo run build --filter=!desktop",
    "lint": "turbo run lint",
    "typecheck": "tsc --noEmit -p apps/desktop/tsconfig.typecheck.json && tsc --noEmit -p packages/product/app/tsconfig.json && tsc --noEmit -p tsconfig.cells.json",
    "build:web": "turbo run build --filter=web",
    "build:desktop": "turbo run build --filter=desktop",
    "test": "turbo run test",
    "workspace:check": "node scripts/workspace.mjs check && node --test scripts/workspace.test.mjs",
    "workspace:refresh": "node scripts/workspace.mjs refresh",
    "test:e2e": "pnpm --filter web-e2e test:e2e",
    "test:e2e:prod": "pnpm --filter web-e2e exec playwright test --config playwright.prod.config.ts",
    "test:e2e:desktop": "playwright test --config tests/desktop-e2e/playwright.config.ts",
    "test:consumer": "pnpm --filter consumer-vite build && node scripts/test-consumer.mjs",
    "pack:dry": "node scripts/pack-public.mjs --dry-run",
    "format": "prettier --write .",
    "release": "pnpm changeset version",
    "pub": "pnpm run build && pnpm changeset publish",
    "postinstall": "node scripts/sync-skills.mjs",
    "skills:sync": "node scripts/sync-skills.mjs",
    "skills:status": "ai-config-manager status"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.36.0",
    "@types/node": "^22.13.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/ui": "^3.0.8",
    "@ylib/ai-config-manager": "1.0.0-beta.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.2.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "jsdom": "~22.1.0",
    "prettier": "^3.1.0",
    "sass": "^1.55.0",
    "turbo": "^2.0.1",
    "@changesets/cli": "^2.27.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.26.0",
    "vite": "^6.2.2",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^3.0.8"
  },
  "private": true
}
